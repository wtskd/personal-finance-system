<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baidu.dao.FinanceAccountMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.baidu.pojo.FinanceAccount">
        <id column="account_id" property="accountId" />
        <result column="account_name" property="accountName" />
        <result column="balance" property="balance" />
        <result column="create_time" property="createTime" />
        <result column="status" property="status" />
        <result column="type_id" property="typeId" />
        <!-- 一对一关联预算类型 -->
        <association property="budgetType" javaType="com.baidu.pojo.BudgetType">
            <result column="type_id" property="typeId" />
            <result column="type_name" property="typeName" />
        </association>
    </resultMap>

    <!-- 分页查询账户（关联预算类型） -->
    <select id="getAccountByPage" resultMap="BaseResultMap">
        SELECT a.*, b.type_name
        FROM t_account a LEFT JOIN t_budget_type b ON a.type_id = b.type_id
        WHERE 1=1
        <if test="accountName != null">
            AND a.account_name LIKE CONCAT('%', #{accountName}, '%')
        </if>
        LIMIT #{start}, #{pageSize}
    </select>

    <!-- 统计总数 -->
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM t_account
        WHERE 1=1
        <if test="accountName != null">
            AND account_name LIKE CONCAT('%', #{accountName}, '%')
        </if>
    </select>

</mapper>
